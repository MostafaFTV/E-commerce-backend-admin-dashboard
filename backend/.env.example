APP_NAME="TKB Backend Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log
SHOPPING_ASSISTANT_ENABLED=false
SHOPPING_ASSISTANT_DAILY_QUOTA_ENABLED=false
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
SHOPPING_ASSISTANT_MODEL=gpt-6.1-terra
SHOPPING_ASSISTANT_MAX_OUTPUT_TOKENS=900
TKB_ALLOWED_HOSTS=localhost,127.0.0.1
